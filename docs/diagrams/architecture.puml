@startuml architecture
!include style.iuml
skinparam nodesep 30
skinparam ranksep 40
skinparam ComponentStyle rectangle
skinparam RectangleFontStyle bold
skinparam defaultTextAlignment center

rectangle "表示层：浏览器单页应用（SPA）" as Browser #EFF6FF {
  rectangle "页面组件\n首页 / 商品详情 / 发布 / 个人中心 / 管理后台" as Pages #FFFFFF
  rectangle "Vue 3\n响应式与组件化" as Vue #FFFFFF
  rectangle "Element Plus\nUI 组件库" as EP #FFFFFF
  rectangle "Vue Router\n路由与登录守卫" as Router #FFFFFF
  rectangle "Axios\n请求封装 + Token 注入" as Axios #FFFFFF
  rectangle "ECharts\n统计图表" as ECharts #FFFFFF
}

rectangle "Spring Boot 3 应用（内嵌 Tomcat，端口 8080）" as Boot #FFF7ED {
  rectangle "静态资源\nindex.html / js / css / lib" as Static #FFFFFF
  rectangle "AuthInterceptor 拦截器\n解析 JWT · 登录校验 · 管理员鉴权 · 封禁检查" as Interceptor #FED7AA
  rectangle "控制层 Controller\nAuth / User / Goods / Order / Favorite /\nComment / Category / File / Admin*" as Controller #FFFFFF
  rectangle "业务层 Service\nUserService · GoodsService · OrderService ·\nFavoriteService · CommentService · CategoryService ·\nStatsService · FileService" as Service #FFFFFF
  rectangle "数据访问层 Repository\nSpring Data JPA（Hibernate）" as Repo #FFFFFF
  rectangle "GlobalExceptionHandler\n统一异常 → ApiResponse" as Advice #FFFFFF
  rectangle "JwtTokenProvider\nHS256 签发 / 校验" as Jwt #FFFFFF
  rectangle "BCryptPasswordEncoder\n密码加密" as Bcrypt #FFFFFF
}

database "H2 文件数据库（默认）\nMySQL 8（mysql profile）" as DB
folder "uploads/\n商品图片" as Uploads

Pages -[hidden]right- Vue
Vue -[hidden]right- EP
Router -[hidden]right- Axios
Axios -[hidden]right- ECharts
Pages -[hidden]down- Router

Axios -down-> Interceptor : HTTP / JSON（REST API）\nAuthorization: Bearer <JWT>
Pages -down-> Static : 加载页面与脚本

Interceptor -down-> Controller
Controller -down-> Service : 调用业务方法\n传入 DTO
Service -down-> Repo
Repo -down-> DB : JDBC
Service -right-> Uploads : 保存图片
Interceptor -right-> Jwt
Service -left-> Bcrypt
Controller -right-> Advice : 抛出异常
@enduml
